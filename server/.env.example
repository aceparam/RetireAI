# ── Server ────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# Public URL of this API (used to build the OAuth callback URL)
API_URL=http://localhost:4000

# Where the Next.js frontend lives (CORS + post-login redirect target)
FRONTEND_URL=http://localhost:3000

# ── Database (PostgreSQL) ───────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/retireai
# Auto-create/update tables from entities (turn OFF in production; use migrations)
DB_SYNCHRONIZE=true
DB_SSL=false

# ── Auth ────────────────────────────────────────────────────────────────────
# Get these from https://console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URI must be:  ${API_URL}/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Secret used to sign JWTs — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
